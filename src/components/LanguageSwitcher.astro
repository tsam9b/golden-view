---
import { locales, localeNames } from "../i18n/ui";
import { getLocale, localizePath, stripLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const basePath = stripLocale(Astro.url.pathname);
---

<label class="lang-select p-1">
  <span class="sr-only">{t("header.language")}</span>
  <select aria-label={t("header.language")} data-lang-select>
    {
      locales.map((code) => (
        <option
          value={localizePath(code, basePath)}
          lang={code}
          selected={code === locale}
        >
          {localeNames[code]}
        </option>
      ))
    }
  </select>
</label>

<script>
  document
    .querySelectorAll<HTMLSelectElement>("[data-lang-select]")
    .forEach((select) => {
      select.addEventListener("change", () => {
        window.location.href = select.value;
      });
    });
</script>

<style>
  .lang-select {
    display: inline-block;
    font-size: inherit;
    font-weight: normal;
  }
  .lang-select select {
    width: auto;
    margin: 0;
    padding: 6px 28px 6px 10px;
    border: 1px solid #ffffff88;
    background: transparent;
    color: inherit;
    font: 13px var(--sans);
    cursor: pointer;
  }
  .lang-select select option {
    color: var(--navy);
    background: #fff;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
