---
import { rooms } from "../data/rooms";
import { getLocale } from "../i18n/utils";
import Recaptcha from "./Recaptcha.astro";

interface Props {
  room?: string;
  showRoomSelect?: boolean;
  variant?: "default" | "orange";
  color?: string;
  placement?: "overlay" | "inline";
}

const {
  room: selectedRoom,
  showRoomSelect = true,
  variant = "default",
  color,
  placement = "overlay",
} = Astro.props;
const locale = getLocale(Astro.currentLocale);
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);

const dateValue = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
};
---

<aside
  class="booking-widget"
  data-booking-widget
  data-variant={variant}
  data-color={color ? "custom" : undefined}
  data-placement={placement}
  style={color ? `--booking-color: ${color};` : undefined}
  aria-labelledby="booking-title"
>
  <div class="booking-widget__panel">
    <form
      class="booking-widget__form"
      action="/contact.php"
      method="post"
      data-booking-search
      data-recaptcha-site-key={import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? ""}
    >
      <input type="hidden" name="lang" value={locale} />
      <input type="hidden" name="name" data-booking-name />
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="booking-widget__honeypot" />
      <div data-booking-search-stage>
        <header class="booking-widget__header">
          <h2 id="booking-title">Search Rooms</h2>
          <p>Start booking</p>
        </header>

        <div class="booking-widget__dates">
          <label class="booking-widget__date">
            <span>Check-in</span>
            <strong data-checkin-display></strong>
            <input
              type="date"
              name="checkin"
              value={dateValue(today)}
              min={dateValue(today)}
              required
              data-checkin
            />
          </label>
          <label class="booking-widget__date">
            <span>Check-out</span>
            <strong data-checkout-display></strong>
            <input
              type="date"
              name="checkout"
              value={dateValue(tomorrow)}
              min={dateValue(tomorrow)}
              required
              data-checkout
            />
          </label>
        </div>

        <label class="booking-widget__field">
          <span class="booking-widget__sr-only">Guests</span>
          <select name="guests" data-guests>
            {Array.from({ length: 6 }, (_, index) => index + 1).map((guests) => (
              <option value={guests} selected={guests === 2}>
                Adults: {guests}
              </option>
            ))}
          </select>
        </label>

        {showRoomSelect ? (
          <label class="booking-widget__field">
            <span class="booking-widget__sr-only">Room</span>
            <select name="room" data-room>
              {rooms.map((room) => (
                <option value={room.title} selected={room.title === selectedRoom}>
                  {room.title}
                </option>
              ))}
            </select>
          </label>
        ) : (
          <input type="hidden" name="room" value={selectedRoom} data-room />
        )}

        <button class="booking-widget__submit" type="button" data-check-availability>
          Check availability
        </button>
      </div>

      <fieldset class="booking-widget__request" data-booking-request-stage disabled hidden>
        <header class="booking-widget__header">
          <h2>Search Rooms</h2>
          <p>Request availability</p>
        </header>

        <div class="booking-widget__name-grid">
          <label>
            <span>First name</span>
            <input type="text" name="first_name" autocomplete="given-name" maxlength="99" required />
          </label>
          <label>
            <span>Last name</span>
            <input type="text" name="last_name" autocomplete="family-name" maxlength="100" required />
          </label>
        </div>

        <div class="booking-widget__name-grid">
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" maxlength="254" required />
          </label>
          <label>
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" maxlength="100" />
          </label>
        </div>

        <label class="booking-widget__summary">
          <span class="booking-widget__sr-only">Booking request</span>
          <textarea name="message" rows="4" maxlength="9800" data-booking-summary required></textarea>
        </label>

        <Recaptcha />
        <button class="booking-widget__submit" type="submit">Submit request</button>
        <button class="booking-widget__back" type="button" data-booking-back>
          Go back
        </button>
      </fieldset>
    </form>
  </div>
</aside>

<script>
  const dateToValue = (date: Date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  };

  const formatDate = (value: string) =>
    new Intl.DateTimeFormat(document.documentElement.lang || "en", {
      day: "numeric",
      month: "short",
    }).format(new Date(`${value}T12:00:00`));

  document.querySelectorAll<HTMLElement>("[data-booking-widget]").forEach((widget) => {
    const checkin = widget.querySelector<HTMLInputElement>("[data-checkin]");
    const checkout = widget.querySelector<HTMLInputElement>("[data-checkout]");
    const checkinDisplay = widget.querySelector<HTMLElement>("[data-checkin-display]");
    const checkoutDisplay = widget.querySelector<HTMLElement>("[data-checkout-display]");
    const guests = widget.querySelector<HTMLSelectElement>("[data-guests]");
    const room = widget.querySelector<HTMLSelectElement | HTMLInputElement>("[data-room]");
    const searchStage = widget.querySelector<HTMLElement>("[data-booking-search-stage]");
    const requestStage = widget.querySelector<HTMLFieldSetElement>("[data-booking-request-stage]");
    const summary = widget.querySelector<HTMLTextAreaElement>("[data-booking-summary]");
    const form = widget.querySelector<HTMLFormElement>("[data-booking-search]");
    const name = widget.querySelector<HTMLInputElement>("[data-booking-name]");
    const firstName = widget.querySelector<HTMLInputElement>('input[name="first_name"]');
    const lastName = widget.querySelector<HTMLInputElement>('input[name="last_name"]');
    const phone = widget.querySelector<HTMLInputElement>('input[name="phone"]');

    if (!checkin || !checkout || !form || !requestStage || !searchStage || !summary || !name || !firstName || !lastName || !phone || !guests || !room) {
      console.error("Booking widget is missing required form elements.");
      return;
    }

    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    checkin.min = dateToValue(today);
    checkout.min = dateToValue(tomorrow);

    const updateDateDisplay = (
      input: HTMLInputElement,
      display: HTMLElement | null,
    ) => {
      if (!display || !input.value) return;
      const date = new Date(`${input.value}T12:00:00`);
      display.innerHTML =
        `${date.getDate()} ` +
        `<small>${new Intl.DateTimeFormat(document.documentElement.lang || "en", { month: "short" }).format(date)}</small>`;
    };

    updateDateDisplay(checkin, checkinDisplay);
    updateDateDisplay(checkout, checkoutDisplay);

    checkin.addEventListener("change", () => {
      if (!checkin.value) return;
      const nextDay = new Date(`${checkin.value}T12:00:00`);
      nextDay.setDate(nextDay.getDate() + 1);
      checkout.min = dateToValue(nextDay);
      if (!checkout.value || checkout.value < checkout.min) {
        checkout.value = checkout.min;
      }
      updateDateDisplay(checkin, checkinDisplay);
      updateDateDisplay(checkout, checkoutDisplay);
    });

    checkout.addEventListener("change", () => {
      updateDateDisplay(checkout, checkoutDisplay);
    });

    widget.querySelector("[data-check-availability]")?.addEventListener("click", () => {
      if (!form.reportValidity()) return;

      summary.value =
        `Could you please inform me about availability and prices for ${guests.value} adults ` +
        `from ${formatDate(checkin.value)} to ${formatDate(checkout.value)} ` +
        `for ${room.value}.`;
      searchStage.hidden = true;
      requestStage.hidden = false;
      requestStage.disabled = false;
      firstName.focus();
    });

    widget.querySelector("[data-booking-back]")?.addEventListener("click", () => {
      requestStage.disabled = true;
      requestStage.hidden = true;
      searchStage.hidden = false;
      widget.querySelector<HTMLButtonElement>("[data-check-availability]")?.focus();
    });

    form.addEventListener("submit", () => {
      name.value = `${firstName.value.trim()} ${lastName.value.trim()}`.trim();
    });

    form.addEventListener("formdata", (event) => {
      if (phone.value.trim()) {
        event.formData.set("message", `${summary.value}\n\nPhone: ${phone.value.trim()}`);
      }
    });
  });
</script>

<style is:global>
  .booking-widget {
    width: 370px;
    max-width: none;
    position: absolute;
    inset: auto;
    z-index: 20;
    top: 158px;
    right: clamp(24px, 19vw, 370px);
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--navy);
    overflow: visible;
  }

  .booking-widget__panel {
    position: relative;
    padding: 30px 32px 32px;
    background: var(--white);
    box-shadow: 0 18px 50px rgba(16, 37, 59, 0.18);
  }

  .booking-widget__request {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .booking-widget__honeypot {
    position: absolute;
    left: -9999px;
  }

  .booking-widget__header {
    margin: 0 0 18px;
    text-align: center;
  }

  .booking-widget__header h2 {
    margin: 0;
    font: 400 30px/1.15 var(--serif);
  }

  .booking-widget__header p {
    margin: 4px 0 0;
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .booking-widget__dates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0 0 16px;
    padding: 16px 0 18px;
    border-top: 1px solid var(--line);
  }

  .booking-widget__date {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .booking-widget__date > span {
    margin-bottom: 8px;
    color: var(--blue);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .booking-widget__date strong {
    color: var(--navy);
    font: 400 46px/0.95 var(--serif);
    white-space: nowrap;
  }

  .booking-widget__date strong small {
    margin-left: 5px;
    font: 400 13px/1 var(--sans);
  }

  .booking-widget__date input {
    position: absolute;
    inset: 22px 0 0;
    width: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .booking-widget__field,
  .booking-widget__summary {
    display: block;
    margin-bottom: 12px;
  }

  .booking-widget__field select,
  .booking-widget__name-grid input,
  .booking-widget__summary textarea {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--white);
    color: var(--navy);
    font: inherit;
  }

  .booking-widget__field select {
    padding: 0 12px;
  }

  .booking-widget__submit {
    width: 100%;
    min-height: 46px;
    border: 0;
    background: var(--blue);
    color: var(--white);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .booking-widget__submit:hover,
  .booking-widget__submit:focus-visible {
    background: var(--blue-dark);
  }

  .booking-widget__name-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }

  .booking-widget__name-grid label {
    display: grid;
    gap: 5px;
  }

  .booking-widget__name-grid label > span {
    color: var(--blue);
    font-size: 12px;
  }

  .booking-widget__name-grid input {
    padding: 8px 10px;
  }

  .booking-widget__summary textarea {
    padding: 12px;
    resize: vertical;
  }

  .booking-widget__back {
    display: block;
    margin: 12px auto 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    cursor: pointer;
  }

  .booking-widget__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__panel {
    background: var(--booking-color, #c85b13);
    color: var(--white);
  }

  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__header p,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__date > span,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__date strong,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__date strong small,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__name-grid label > span,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__back {
    color: var(--white);
  }

  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__dates {
    border-color: color-mix(in srgb, var(--white) 55%, transparent);
  }

  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__submit {
    background: var(--white);
    color: color-mix(in srgb, var(--booking-color, #c85b13), black 25%);
  }

  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__submit:hover,
  .booking-widget:is([data-variant="orange"], [data-color="custom"]) .booking-widget__submit:focus-visible {
    background: #fff3e8;
  }

  .booking-widget[data-placement="inline"] {
    position: static;
    inset: auto;
    width: 100%;
    max-width: none;
    margin: 0;
  }

  @media (max-width: 760px) {
    .booking-widget {
      width: calc(100vw - 24px);
      max-width: 370px;
      top: 100px;
      right: 12px;
      margin: 0;
    }

    .booking-widget__panel {
      padding-inline: 20px;
    }

    .booking-widget__name-grid {
      grid-template-columns: 1fr;
    }
  }

</style>
