---
import { Image } from "astro:assets";
import room from "../assets/features/6-1000x570.jpg";
import { getLocale, localizePath, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---


<section class="wellness">
    <div class="wellness-image" data-reveal>
      <Image
        src={room}
        alt={t("about.imageAlt")}
        widths={[480, 720, 960]}
        sizes="(max-width: 760px) 100vw, 50vw"
        format="avif"
        loading="lazy"
      />
    </div>
    <div class="wellness-copy" data-reveal>
      <p class="eyebrow">{t("about.eyebrow")}</p><h2 set:html={t("about.heading")} />
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
      <p>{t("about.p3")}</p>
      <a class="btn" href={localizePath(locale, "/room")}>{t("about.button")}</a>
    </div>
  </section>