---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { RoomItem } from "../data/rooms";
import { getFolderGalleryPhotos, getRoomsGallery } from "../data/rooms-gallery";
import { getLocale, localizePath, useTranslations } from "../i18n/utils";

type Photo = { src: ImageMetadata; preview?: ImageMetadata };
interface Props {
  room?: RoomItem;
  sharedPhotos?: Photo[];
  folders?: boolean;
}

const { room, sharedPhotos, folders = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const name = room ? `${room.title} ${room.description}` : t("gallery.title");
const galleryPhotos: Photo[] = folders
  ? getFolderGalleryPhotos()
  : room
    ? getRoomsGallery(room.slug).photos
    : sharedPhotos ?? [];

const photos = await Promise.all(
  galleryPhotos.map(async (photo, i) => ({
    preview: photo.preview ?? photo.src,
    src: photo.src,
    alt: `${name} - ${t("room.photo", { n: i + 1 })}`,
    full: (
      await getImage({ src: photo.src, width: Math.min(photo.src.width, 2400), format: "webp", quality: 92 })
    ).src,
  })),
);

// Repeating mosaic pattern: one large tile, one wide tile, the rest regular.
const tileClass = (i: number) => (i % 7 === 0 ? "is-large" : i % 7 === 4 ? "is-wide" : "");
---

<section class="room-gallery" id={room?.slug} data-lazy-gallery>
  {room && <header class="room-gallery-head">
    <h3>{name}</h3>
    <a href={localizePath(locale, `/rooms/${room.slug}`)}>{t("gallery.viewRoom")} ↗</a>
  </header>}
  <div class="room-gallery-grid" style={`min-height: ${Math.ceil(photos.length / 2) * 260}px;`}>
    <template>
      {photos.map((photo, i) => (
        <button
          type="button"
          class={`tile ${tileClass(i)}`}
          data-full={photo.full}
          data-alt={photo.alt}
          aria-label={photo.alt}
        >
          <Image
            src={photo.preview}
            alt={photo.alt}
            widths={[500, 800, 1200]}
            sizes={i % 7 === 0 ? "(min-width: 900px) 66vw, 100vw" : "(min-width: 900px) 33vw, 50vw"}
            format="avif"
            loading="lazy"
          />
        </button>
      ))}
    </template>
  </div>

  <dialog class="lightbox" aria-label={name}>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label={t("gallery.close")}>×</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={t("room.prevPhoto")}>‹</button>
    <img alt="" data-lb-img />
    <div class="lb-spinner" aria-hidden="true"></div>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label={t("room.nextPhoto")}>›</button>
  </dialog>
</section>

<script>
  const load = (section: HTMLElement) => {
    const grid = section.querySelector<HTMLElement>(".room-gallery-grid");
    const template = grid?.querySelector("template");
    if (!grid || !template) return;
    grid.appendChild(template.content.cloneNode(true));
    template.remove();
    grid.style.minHeight = "";
  };

  const setupLightbox = (section: HTMLElement) => {
    const dialog = section.querySelector<HTMLDialogElement>("dialog");
    const lbImg = dialog?.querySelector<HTMLImageElement>("[data-lb-img]");
    if (!dialog || !lbImg) return;
    let tiles: HTMLElement[] = [];
    let index = 0;

    let request = 0;

    const preload = (i: number) => {
      const pre = new Image();
      pre.src = tiles[(i + tiles.length) % tiles.length].dataset.full ?? "";
      return pre;
    };

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length;
      const current = ++request;
      const pre = preload(index);
      const done = () => {
        if (current !== request) return;
        lbImg.src = pre.src;
        lbImg.alt = tiles[index].dataset.alt ?? "";
        dialog.classList.remove("is-loading");
      };
      dialog.classList.add("is-loading");
      pre.decode().then(done, done);
      preload(index + 1);
      preload(index - 1);
    };

    section.addEventListener("click", (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLElement>(".tile");
      if (!tile) return;
      tiles = Array.from(section.querySelectorAll<HTMLElement>(".tile"));
      show(tiles.indexOf(tile));
      dialog.showModal();
    });

    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest("[data-lb-close]")) dialog.close();
      else if (target.closest("[data-lb-prev]")) show(index - 1);
      else if (target.closest("[data-lb-next]")) show(index + 1);
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    dialog.addEventListener("close", () => {
      request++;
      dialog.classList.remove("is-loading");
      lbImg.removeAttribute("src");
    });
  };

  const sections = document.querySelectorAll<HTMLElement>("[data-lazy-gallery]");
  sections.forEach(setupLightbox);

  if (!("IntersectionObserver" in window)) {
    sections.forEach(load);
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          load(entry.target as HTMLElement);
        });
      },
      { rootMargin: "400px 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .room-gallery {
    margin: 0 auto 5rem;
  }

  .room-gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .room-gallery-head h2 {
    margin: 0;
  }

  .room-gallery-head a {
    color: var(--gold);
    white-space: nowrap;
  }

  .room-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 260px;
    grid-auto-flow: dense;
    gap: 0.6rem;
  }

  .room-gallery-grid :global(.tile) {
    position: relative;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--sand);
    cursor: zoom-in;
    animation: gallery-fade 0.5s ease both;
  }

  .room-gallery-grid :global(.tile.is-large) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .room-gallery-grid :global(.tile.is-wide) {
    grid-column: span 2;
  }

  .room-gallery-grid :global(.tile img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .room-gallery-grid :global(.tile:hover img),
  .room-gallery-grid :global(.tile:focus-visible img) {
    transform: scale(1.05);
  }

  @keyframes gallery-fade {
    from {
      opacity: 0;
    }
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 16, 26, 0.94);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox img {
    transition: opacity 0.2s;
  }

  .lightbox.is-loading img {
    opacity: 0.35;
  }

  .lb-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border: 4px solid rgba(255, 255, 255, 0.35);
    border-top-color: var(--gold);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: lb-spin 0.8s linear infinite;
    transition: opacity 0.15s;
  }

  .lightbox.is-loading .lb-spinner {
    opacity: 1;
    transition-delay: 0.1s;
  }

  @keyframes lb-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lb-close {
    top: 1rem;
    right: 1rem;
  }

  .lb-prev {
    left: 1rem;
  }

  .lb-next {
    right: 1rem;
  }

  @media (max-width: 900px) {
    .room-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }
  }

  @media (max-width: 560px) {
    .room-gallery-grid {
      grid-auto-rows: 160px;
    }
  }
</style>
