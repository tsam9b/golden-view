---
import { Image } from "astro:assets";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  price?: string | null;
  title: string;
  description?: string | null;
  classes?: string[];
  size?: "sm" | "md" | "lg";
}

const {
  href,
  image,
  imageAlt,
  price,
  title,
  description,
  classes = [],
  size = "md",
} = Astro.props;

const imageSizes = {
  sm: {
    widths: [360, 540, 720],
    sizes: "(max-width: 760px) 100vw, (max-width: 1000px) 50vw, 25vw",
  },
  md: {
    widths: [480, 720, 960],
    sizes: "(max-width: 760px) 100vw, (max-width: 1000px) 50vw, 33vw",
  },
  lg: {
    widths: [640, 960, 1280, 1600],
    sizes: "(max-width: 760px) 100vw, (max-width: 1000px) 75vw, 50vw",
  },
}[size];
---

<a class:list={["room", ...classes]} href={href}>
  <Image
    src={image}
    alt={imageAlt}
    widths={imageSizes.widths}
    sizes={imageSizes.sizes}
    format="avif"
    loading="lazy"
  />

  <i>{price}</i>

  <div class="room-label">
    <h3>{title}</h3>
    <medium>{description}</medium>
  </div>
</a>