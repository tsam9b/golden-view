---
import { Image } from "astro:assets";
import { theme } from "../config/theme";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  price?: string | null;
  title: string;
  description?: string | null;
  classes?: string[];
  size?: "sm" | "md" | "lg";
  columns?: number;
}

const {
  href,
  image,
  imageAlt,
  price,
  title,
  description,
  classes = [],
  size = "md",
  columns = 3,
} = Astro.props;

const imageRatio = image.width / image.height;
const cardAspect = theme.cards.aspect;
const [aspectWidth, aspectHeight] = cardAspect === "auto"
  ? [1, 1]
  : cardAspect.split("/").map(Number);
// object-fit: cover may scale the image wider than the visible card.
const widthFactor = cardAspect === "auto"
  ? 1
  : Math.max(1, imageRatio * aspectHeight / aspectWidth);
const minimumWidth = cardAspect === "auto"
  ? Math.ceil(imageRatio * ({ sm: 340, md: 480, lg: 620 }[size]))
  : 0;
const slot = (viewportShare: number) => {
  const width = `${Math.ceil(viewportShare * widthFactor * 100) / 100}vw`;
  return minimumWidth ? `max(${width}, ${minimumWidth}px)` : width;
};
const sizes = `(max-width: 760px) ${slot(100)}, (max-width: 1000px) ${slot(50)}, ${slot(100 / columns)}`;
---

<a class:list={["room", ...classes]} href={href}>
  <Image
    src={image}
    alt={imageAlt}
    widths={[360, 540, 720, 960, 1280, 1600, 1920]}
    sizes={sizes}
    format="avif"
    loading="lazy"
  />

  <i>{price}</i>

  <div class="room-label">
    <div style="font-size: 25px;">{title}</div>
    <div style="font-size: 18px;">{description}</div>
  </div>
</a>