---
import { getLocale, useTranslations } from "../i18n/utils";

const t = useTranslations(getLocale(Astro.currentLocale));
---

<section class="intro-text">
  <h4 style="text-align: right;font-weight: 200;">{t("introText.heading")}</h4>
  <p>{t("introText.details")}</p>
  <p>{t("introText.contact")}</p>
</section>
