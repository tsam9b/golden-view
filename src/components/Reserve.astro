---
import type { RoomItem } from "../data/rooms";
import { useTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/ui";

interface Props {
  room: Pick<RoomItem, "eyebrow" | "title" | "description" | "rate">;
  locale: Locale;
  backHref: string;
  contactHref: string;
  showPrice?: boolean;
}

const {
  room,
  locale,
  backHref,
  contactHref,
  showPrice = true,
} = Astro.props;
const t = useTranslations(locale);

console.log(showPrice);
---

<div class="suite-hero-copy">
  <a class="back-link" href={backHref}>← {t("room.backToAll")}</a>
  <p class="eyebrow">{room.eyebrow}</p>
  <h3>{room.title + " " + room.description}</h3>
  <p>{room.description}</p>
  <a class="btn" href={contactHref}>
    {showPrice ? t("room.reserveFrom", { rate: room.rate }) : t("room.reserve")} ↗
  </a>
</div>
