---
import { getLocale, useTranslations } from "../i18n/utils";
import { site } from "../config/site";

interface Props {
  location: string;
  title?: string;
  height?: string;
  zoom?: number;
  name?: string;
  address?: string;
  mapsHref?: string;
}

const {
  location,
  title = useTranslations(getLocale(Astro.currentLocale))("footer.maps"),
  height = "450px",
  zoom = 15,
  name = site.name,
  address = `${site.address1}, ${site.address2}`,
  mapsHref = site.social.maps,
} = Astro.props;

const mapUrl = `https://maps.google.com/maps?q=${encodeURIComponent(
  location
)}&t=&z=${zoom}&ie=UTF8&iwloc=&output=embed`;
---

<div class="google-map" style={`--map-height: ${height}`}>
  <div class="map-card" aria-label={`${name} location`}>
    <strong>{name}</strong>
    <span>{address}</span>
    <a href={mapsHref} target="_blank" rel="noopener noreferrer">
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14 3h7v7M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
      </svg>
      Open in Maps
    </a>
  </div>
  <iframe
    src={mapUrl}
    title={title}
    width="100%"
    height="100%"
    style="border: 0;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>