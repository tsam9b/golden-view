---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rooms from "../../components/Rooms.astro";
import Reserve from "../../components/Reserve.astro";
import { rooms } from "../../data/rooms";
import { getRoomsGallery } from "../../data/rooms-gallery";
import {
  getLocale,
  localizePath,
  translateFacility,
  useTranslations,
} from "../../i18n/utils";

export function getStaticPaths() {
  return rooms.map((item) => ({
    params: { slug: item.slug },
    props: { room: item },
  }));
}


// const room = rooms[room.slug as keyof typeof rooms];

const { room } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);


const roomsGallery = getRoomsGallery(room.slug);
const gallery = roomsGallery.photos.map((photo, index) => ({
  ...photo,
  alt: `${room.title} ${room.description} - ${t("room.photo", { n: index + 1 })}`,
}));

---

<BaseLayout title={room.title + ' ' + room.description} description={`${room.title + ' ' + room.description}: ${room.description}`} headerBg={false}>
  <section class="suite-hero">
    <div class="suite-hero-image">
      <Image
        src={roomsGallery.mainImage ?? room.image}
        alt={room.slug}
        widths={[768, 1200, 1600]}
        sizes="100vw"
        format="avif"
        loading="eager"
      />
    </div>
    <Reserve
      room={room}
      locale={locale}
      backHref={localizePath(locale, "/rooms")}
      contactHref={localizePath(locale, "/contact")}
      showPrice={false}
    />
  </section>

  <nav class="room-nav" aria-label="Room sections">
    <a href="#description">Description</a>
    <a href="#room-services">Room services</a>
    <a href="#other-rooms">Other rooms</a>
  </nav>

  <section class="section suite-detail">
    <div class="detail-wrap">
      <div class="detail-grid">
        <div class="detail-main">
          <header class="detail-head">
            <h2>{room.title}</h2>
            <ul class="detail-stats">
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                </svg>
                <span>{t("room.guests", { n: room.guests })}</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" />
                  <path d="M3 12h9V3M12 12v9" />
                </svg>
                <span>{room.size}</span>
              </li>
            </ul>
          </header>

          <!-- Gallery -->
          <div class="gallery" data-gallery>
            <div class="gallery-stage">
              {gallery.map((g, i) => (
                <div class={`gallery-slide ${i === 0 ? "is-active" : ""}`} data-slide>
                  <Image
                    src={g.src}
                    alt={g.alt}
                    widths={[900, 1400, 1900]}
                    sizes="(min-width: 1200px) 900px, 100vw"
                    format="webp"
                    quality={88}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))}
              <div class="gallery-spinner" aria-hidden="true"></div>
              <button class="gallery-arrow prev" type="button" aria-label={t("room.prevPhoto")} data-prev>‹</button>
              <button class="gallery-arrow next" type="button" aria-label={t("room.nextPhoto")} data-next>›</button>
            </div>

            <div class="gallery-thumbs">
              {gallery.map((g, i) => (
                <button
                  type="button"
                  class={`thumb ${i === 0 ? "is-active" : ""}`}
                  data-thumb={i}
                  aria-label={t("room.showPhoto", { n: i + 1 })}
                >
                  <Image src={g.src} alt="" width={140} height={90} format="webp" quality={60} loading="lazy" />
                </button>
              ))}
            </div>
          </div>

          <!-- Description -->
          <div class="detail-copy" id="description">
            <p>{room.fullDescription}</p>
          </div>

          <!-- Facilities -->
          <div class="detail-block" id="room-services">
            <h3>{t("room.facilities")}</h3>
            <ul class="facilities">
              {room.facilities.map((facility) => <li>{translateFacility(locale, facility)}</li>)}
            </ul>
          </div>
        </div>

        <!-- Booking panel -->
        <aside class="detail-side">
          <form class="book-card" action={localizePath(locale, "/contact")} method="get" data-booking-form>
            <div class="booking-dates">
              <label>
                <span>Check-in</span>
                <input type="date" name="checkin" required aria-label="Check-in date" />
              </label>
              <label>
                <span>Check-out</span>
                <input type="date" name="checkout" required aria-label="Check-out date" />
              </label>
            </div>
            <label class="booking-guests">
              <span>Travellers</span>
              <select name="guests" aria-label="Number of travellers">
                {Array.from({ length: room.guests }, (_, index) => index + 1).map((guests) => (
                  <option value={guests} selected={guests === room.guests}>
                    {guests === 1 ? "1 traveller" : `${guests} travellers`}
                  </option>
                ))}
              </select>
            </label>
            <input type="hidden" name="room" value={room.title} />
            <button class="btn booking-submit" type="submit">{t("room.reserve")} now ↗</button>
          </form>
        </aside>
      </div>

      <!-- Other rooms -->
      <div id="other-rooms">
        <Rooms
          exclude={room.slug}
          showTitle={true}
          size="sm"
          horizontalPadding="250px"
        />
      </div>
    </div>
  </section>

  <script>
    const dateToValue = (date: Date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };

    document.querySelectorAll<HTMLFormElement>("[data-booking-form]").forEach((form) => {
      const checkin = form.querySelector<HTMLInputElement>('input[name="checkin"]');
      const checkout = form.querySelector<HTMLInputElement>('input[name="checkout"]');
      if (!checkin || !checkout) return;

      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      checkin.min = dateToValue(today);
      checkin.value = dateToValue(today);
      checkout.min = dateToValue(tomorrow);
      checkout.value = dateToValue(tomorrow);

      checkin.addEventListener("change", () => {
        const nextDay = new Date(`${checkin.value}T12:00:00`);
        nextDay.setDate(nextDay.getDate() + 1);
        const minimumCheckout = dateToValue(nextDay);
        checkout.min = minimumCheckout;
        if (!checkout.value || checkout.value < minimumCheckout) {
          checkout.value = minimumCheckout;
        }
      });
    });

    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
      const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
      const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-thumb]"));
      if (slides.length === 0) return;
      const stage = root.querySelector<HTMLElement>(".gallery-stage");
      let index = 0;

      const eagerLoad = (n: number) => {
        const image = slides[(n + slides.length) % slides.length].querySelector("img");
        if (image) image.loading = "eager";
        return image;
      };

      const show = (i: number) => {
        index = (i + slides.length) % slides.length;
        slides.forEach((s, n) => s.classList.toggle("is-active", n === index));
        thumbs.forEach((t, n) => {
          t.classList.toggle("is-active", n === index);
          t.setAttribute("aria-current", n === index ? "true" : "false");
        });

        const current = eagerLoad(index);
        eagerLoad(index + 1);
        eagerLoad(index - 1);

        if (current) {
          const shown = index;
          const done = () => {
            if (index === shown) stage?.classList.remove("is-loading");
          };
          stage?.classList.add("is-loading");
          current.decode().then(done, done);
        }
      };

      show(0);

      const preloadAll = () =>
        slides.forEach((s) => {
          const image = s.querySelector("img");
          if (image) image.loading = "eager";
        });
      if (document.readyState === "complete") preloadAll();
      else window.addEventListener("load", preloadAll, { once: true });

      root.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (target.closest("[data-prev]")) show(index - 1);
        else if (target.closest("[data-next]")) show(index + 1);
        else {
          const thumb = target.closest<HTMLButtonElement>("[data-thumb]");
          if (thumb) show(thumbs.indexOf(thumb));
        }
      });
    });
  </script>

</BaseLayout>
