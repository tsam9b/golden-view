---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const t = useTranslations(getLocale(Astro.currentLocale));
---

<BaseLayout title={t("policies.title")} description={t("policies.description")}>
  <section class="page">
    <h1 style="padding-top: 4rem; text-align:center;">
      {t("policies.title")}
    </h1>
  </section>

  <section class="policies" style="width:70%; padding-top: 4rem; text-align:left;margin: 0 auto;">
    <div>
      <p><strong>{t("policies.cancellation")}</strong></p>
      <ul>
        <li>{t("policies.cancellation.1")}</li>
        <li>{t("policies.cancellation.2")}</li>
        <li>{t("policies.cancellation.3")}</li>
        <li>{t("policies.cancellation.4")}</li>
      </ul>
      <p>&nbsp;</p>
      <p>
        <strong>{t("policies.prepayment")}</strong>&nbsp;{t("policies.prepayment.text")}
      </p>
      <p>&nbsp;</p>
 
      <p><strong>{t("policies.checkin")}</strong>&nbsp;{t("policies.checkin.text")}</p>
      <p><strong>{t("policies.checkout")}</strong>&nbsp;{t("policies.checkout.text")}</p>
      <p>&nbsp;</p>
     
      <div>
        <p><strong>{t("policies.extraBeds")}</strong></p>
        <ul>
          <li set:html={t("policies.extraBeds.1")} />
          <li>{t("policies.extraBeds.2")}</li>
          <li>{t("policies.extraBeds.3")}</li>
        </ul>
      </div>
      <p>&nbsp;</p>
      <p><strong>{t("policies.pets")}</strong>&nbsp;{t("policies.pets.text")}</p>
      <p>&nbsp;</p>
      <p>
        <strong>{t("policies.cards")}</strong>&nbsp;{t("policies.cards.text")}
      </p>
    </div>
  </section>
</BaseLayout>
